# ── Application ──────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=DEBUG

# ── Database (Local Docker) ───────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://dev_user:dev_password@localhost:5442/ai_receptionist
AUDIT_DATABASE_URL=postgresql+asyncpg://audit_user:audit_password@localhost:5443/ai_receptionist_audit

# ── Redis (Local Docker) ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev_redis_password
REDIS_USE_TLS=false

