# ── Telnyx ────────────────────────────────────────────────────────
TELNYX_API_KEY=KEY0123456789xxxxxxxxxxxxx
TELNYX_PUBLIC_KEY=BASE64_ED25519_PUBLIC_KEY_HERE
TELNYX_APP_ID=your_telnyx_app_id

